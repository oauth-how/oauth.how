---
const actors = [
  { x: 61, label: "Browser", icon: "M-8 -6h16v12h-16z M-8 -2h16" },
  {
    x: 177,
    label: "Client",
    icon: "M-8 -5l-4 5 4 5 M8 -5l4 5-4 5 M2 -7l-4 14",
  },
  {
    x: 293,
    label: "Auth server",
    icon: "M0 -9l8 3v5c0 5-8 9-8 9s-8-4-8-9v-5z M-3 0l2 2 4-4",
  },
  { x: 409, label: "API", icon: "M-8 -6h16v12h-16z M-8 0h16 M-5 -3h1 M-5 3h1" },
];
---

<figure class="flow-preview">
  <div class="preview-toolbar">
    <div class="window-dots" aria-hidden="true">
      <i></i>
      <i></i>
      <i></i>
    </div>
    <span>OAuth 2.0 flow</span>
    <span class="preview-tag">PKCE / S256</span>
  </div>
  <svg
    class="preview-svg"
    viewBox="0 0 470 278"
    role="img"
    aria-labelledby="preview-title preview-description"
  >
    <title id="preview-title">Authorization Code with PKCE preview</title>
    <desc id="preview-description">
      The browser visits the authorization server with a challenge, delivers the
      code to the client, and the client presents its verifier to the
      authorization server before accessing the API.
    </desc>
    <defs>
      <marker
        id="preview-arrow"
        markerWidth="7"
        markerHeight="7"
        refX="7"
        refY="3.5"
        orient="auto"
        markerUnits="userSpaceOnUse"
      >
        <path d="M0 0l7 3.5L0 7z" fill="#a4a3c0" />
      </marker>
      <marker
        id="preview-active-arrow"
        markerWidth="8"
        markerHeight="8"
        refX="8"
        refY="4"
        orient="auto"
        markerUnits="userSpaceOnUse"
      >
        <path d="M0 0l8 4L0 8z" fill="#9fedcd" />
      </marker>
    </defs>
    {actors.map(({ x, label, icon }) => (
      <g transform={`translate(${x} 35)`}>
        <path d="M0 47v185" stroke="#43405e" stroke-dasharray="4 5" />
        <rect
          x="-18"
          y="-18"
          width="36"
          height="36"
          rx="9"
          fill="#2c2849"
          stroke="#494368"
        />
        <path
          d={icon}
          fill="none"
          stroke="#d0c6ff"
          stroke-width="1.5"
          stroke-linejoin="round"
          stroke-linecap="round"
        />
        <text y="41" text-anchor="middle" class="preview-actor">
          {label}
        </text>
      </g>
    ))}
    <g class="preview-message">
      <text x="177" y="105">
        Authorize + challenge
      </text>
      <path d="M63 116h228" marker-end="url(#preview-arrow)" />
      <text x="177" y="143">
        Redirect with code
      </text>
      <path d="M291 154H63" marker-end="url(#preview-arrow)" />
      <text x="119" y="181">
        Callback
      </text>
      <path d="M63 192h112" marker-end="url(#preview-arrow)" />
      <rect
        x="139"
        y="204"
        width="191"
        height="39"
        rx="7"
        fill="#323852"
        stroke="#566f70"
      />
      <text x="235" y="221" class="preview-active-label">
        Exchange code + verifier
      </text>
      <path
        d="M178 230h113"
        class="preview-active-line"
        marker-end="url(#preview-active-arrow)"
      />
      <circle cx="240" cy="230" r="4" fill="#9fedcd" />
      <text x="293" y="255">
        Call API with access token
      </text>
      <path d="M179 265h228" marker-end="url(#preview-arrow)" />
    </g>
  </svg>
  <figcaption>
    <span class="preview-status">Token exchange</span>
    <a href="/playground/#pkce">Open simulation</a>
  </figcaption>
</figure>
