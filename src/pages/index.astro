---
import FlowPreview from "../components/FlowPreview.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  home
  title="OAuth explained. One flow at a time. · oauth.how"
  description="Learn OAuth 2.0, OpenID Connect, and tokens through illustrated lessons, interactive protocol flows, and inspectable HTTP exchanges."
>
  <section class="home-hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">
          <span></span> OAuth, OpenID Connect &amp; tokens
        </p>
        <h1>
          OAuth explained.
          <br />
          <em>One flow at a time.</em>
        </h1>
        <p class="hero-description">
          See what happens between the browser, the app, and the API. Follow
          each message, inspect the HTTP, and understand why the protocol works.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="/learn/">
            Start learning
          </a>
          <a class="button secondary" href="/playground/">
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path
                d="M6 3.5 16 10 6 16.5V3.5Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linejoin="round"
              />
            </svg>
            Try the playground
          </a>
        </div>
      </div>
      <FlowPreview />
    </div>
  </section>
  <section class="wrap home-paths">
    <div class="section-heading">
      <h2>Find your starting point</h2>
      <p>Build the mental model, then follow the messages on the wire.</p>
    </div>
    <div class="path-grid">
      <a class="path-card" href="/learn/authentication-vs-authorization/">
        <span class="path-icon lavender">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 6v14m0-14C9 4 6 4 3 5v14c3-1 6-1 9 1 3-2 6-2 9-1V5c-3-1-6-1-9 1Z" />
          </svg>
        </span>
        <h3>Start with the basics</h3>
        <p>
          Learn what authentication, authorization, and delegated access each
          do.
        </p>
        <span class="path-link">Read the first lesson</span>
      </a>
      <a class="path-card" href="/learn/authorization-code-pkce/">
        <span class="path-icon mint">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 7h15m-4-4 4 4-4 4m5 6H5m4-4-4 4 4 4" />
          </svg>
        </span>
        <h3>Follow a real flow</h3>
        <p>
          Step through Authorization Code + PKCE, from the browser redirect to
          the API call.
        </p>
        <span class="path-link">Explore Authorization Code + PKCE</span>
      </a>
      <a class="path-card" href="/playground/#tokens">
        <span class="path-icon peach">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m8 5-6 7 6 7m8-14 6 7-6 7m-2-16-4 18" />
          </svg>
        </span>
        <h3>Look inside a token</h3>
        <p>
          Decode a sample JWT and see what changes when you verify its signature
          and claims.
        </p>
        <span class="path-link">Open the token inspector</span>
      </a>
    </div>
  </section>
</SiteLayout>
