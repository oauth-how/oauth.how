---
import {
  BookOpen,
  Braces,
  ChevronRight,
  Network,
  Play,
  Radio,
} from "@lucide/astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import SimulationPlayer from "../components/SimulationPlayer";
import { pkceFlow } from "../simulation/flows/authorization-code-pkce";

const entryPoints = [
  {
    href: "/learn/authentication-vs-authorization/",
    icon: BookOpen,
    label: "Read the first lesson",
    question: "Is signing in the same as granting access?",
    description: "Untangle identity, permissions, and delegated access.",
  },
  {
    href: "/learn/authorization-code-pkce/",
    icon: Network,
    label: "Follow Authorization Code + PKCE",
    question: "What happens after you click Connect?",
    description: "Follow the browser redirect, code exchange, and API call.",
  },
  {
    href: "/playground/#tokens",
    icon: Braces,
    label: "Open the token inspector",
    question: "What’s inside an access token?",
    description: "Decode a sample JWT, then test its signature and claims.",
  },
];
---

<SiteLayout
  home
  title="OAuth explained. One flow at a time. · oauth.how"
  description="Learn OAuth 2.0, OpenID Connect, and tokens through illustrated lessons, interactive protocol flows, and inspectable HTTP exchanges."
>
  <section class="home-hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="kicker">
          <Radio size={16} stroke-width={1.8} aria-hidden="true" />
          Interactive protocol guide
        </p>
        <h1>
          <span>OAuth explained.</span>
          <span>One flow at a time.</span>
        </h1>
        <p class="hero-description">
          What happens between your browser, an app, and an API? Step through an
          OAuth flow, inspect the HTTP messages, and see what each actor checks.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="/learn/">
            <BookOpen size={18} stroke-width={1.8} aria-hidden="true" />
            Start learning
          </a>
          <a class="button secondary" href="/playground/">
            <Play size={17} stroke-width={1.8} aria-hidden="true" />
            Try the playground
          </a>
        </div>
      </div>
      <section
        class="hero-demo"
        aria-label="Interactive Authorization Code with PKCE preview"
      >
        <SimulationPlayer flow={pkceFlow} compact client:visible />
        <noscript>
          <p class="no-js-demo">
            <a href="/playground/#pkce">
              Read the full flow transcript in the Playground.
            </a>
          </p>
        </noscript>
      </section>
    </div>
  </section>
  <section class="home-paths" aria-labelledby="start-heading">
    <div class="wrap paths-layout">
      <header>
        <h2 id="start-heading">Start with a question</h2>
        <p>
          Pick a concept, follow a flow, or get hands-on with a sample token.
        </p>
      </header>
      <ul class="path-list">
        {entryPoints.map(
          ({ href, icon: Icon, label, question, description }) => (
            <li>
              <a class="path-link" href={href}>
                <span class="path-icon">
                  <Icon size={22} stroke-width={1.7} aria-hidden="true" />
                </span>
                <span class="path-content">
                  <strong>{question}</strong>
                  <span>{description}</span>
                </span>
                <span class="path-action">
                  <span>{label}</span>
                  <ChevronRight
                    size={18}
                    stroke-width={1.8}
                    aria-hidden="true"
                  />
                </span>
              </a>
            </li>
          ),
        )}
      </ul>
    </div>
  </section>
</SiteLayout>
